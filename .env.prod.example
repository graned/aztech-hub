DESIGN_URL=https://design.aztech-hub.com
WORKSPACE_URL=https://workspace.aztech-hub.com
CODING_URL=https://coding.aztech-hub.com

# Open Design authentication.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='replace-with-caddy-bcrypt-hash'
SESSION_TOKEN=replace-with-64-hex-session-token

# Workspace Manager/OpenCode authentication and persistence.
MONGO_INITDB_ROOT_USERNAME=opencode
MONGO_INITDB_ROOT_PASSWORD=replace-with-mongo-password
MONGODB_URI=mongodb://opencode:replace-with-mongo-password@mongodb:27017/opencode_workspace_manager?authSource=admin
OPENCODE_SERVER_USERNAME=internal-opencode
OPENCODE_SERVER_PASSWORD=replace-with-opencode-password
# printf '%s' 'internal-opencode:replace-with-opencode-password' | base64 -w0
OPENCODE_BASIC_AUTH=replace-with-base64-username-password
GITHUB_TOKEN=

# Workspace Manager browser authentication.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD_HASH='replace-with-caddy-bcrypt-hash'
