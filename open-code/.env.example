# OpenCode Workspace Manager environment
# Copy to .env and fill in required values.
# Local Compose uses the defaults below with no changes needed.
# Production Compose requires every `:?` variable to be set.

WORKSPACE_URL=http://workspace.localhost
CODING_URL=http://coding.localhost

# --- Shared, local defaults (override in .env) ---
MONGO_INITDB_ROOT_USERNAME=opencode
MONGO_INITDB_ROOT_PASSWORD=opencode
MONGODB_URI=mongodb://opencode:opencode@mongodb:27017/opencode_workspace_manager?authSource=admin

OPENCODE_SERVER_USERNAME=localopencode
OPENCODE_SERVER_PASSWORD=localopencode

# GitHub token used by the browsing/clone adapter. Empty disables GitHub features.
GITHUB_TOKEN=

# Base64 of OPENCODE_SERVER_USERNAME:OPENCODE_SERVER_PASSWORD.
# Generate with: printf '%s' 'username:password' | base64 -w0
OPENCODE_BASIC_AUTH=bG9jYWxvcGVuY29kZTpsb2NhbG9wZW5jb2Rl

# --- Production-only overrides (required in .env.prod) ---
# WORKSPACE_URL=https://workspace.aztech-hub.com
# CODING_URL=https://coding.aztech-hub.com
# BASIC_AUTH_USER=admin
# Bcrypt hash produced by: caddy hash-password --plaintext 'your-password'
# BASIC_AUTH_HASH=
