# Absolute host paths used by the unified root Compose stack.
# Replace these with the paths printed by scripts/setup-github-ssh.sh.
OPENCODE_SSH_KEY_PATH=/home/your-user/.config/opencode-workspace-manager/ssh/id_ed25519
OPENCODE_KNOWN_HOSTS_PATH=/home/your-user/.config/opencode-workspace-manager/ssh/known_hosts
